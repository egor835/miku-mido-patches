From 67c4727823ecfce691e47d5899ef42b633a94347 Mon Sep 17 00:00:00 2001
From: Egor <egor.su.8@gmail.com>
Date: Tue, 10 Nov 2026 20:35:40 +0300
Subject: [PATCH 14/15] mido: Switch to AIDL basic USB HAL

The HIDL 1.3 basic HAL reports a permanently connected sink port and
can't report USB data status, so Android 17 treats it as a connected
data-disabled port and keeps showing "Charging this device via USB"
even with nothing plugged in. The AIDL variant reports data as enabled.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device.mk                          | 2 +-
 sepolicy/miku/vendor/file_contexts | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/device.mk b/device.mk
index 873e75b..ea59705 100644
--- a/device.mk
+++ b/device.mk
@@ -411,7 +411,7 @@ PRODUCT_SOONG_NAMESPACES += \
     vendor/qcom/opensource/usb/etc
 
 PRODUCT_PACKAGES += \
-    android.hardware.usb@1.3-service.basic
+    android.hardware.usb-service.basic
 
 # Vibrator
 PRODUCT_PACKAGES += \
diff --git a/sepolicy/miku/vendor/file_contexts b/sepolicy/miku/vendor/file_contexts
index 53e7eeb..ee79bbe 100644
--- a/sepolicy/miku/vendor/file_contexts
+++ b/sepolicy/miku/vendor/file_contexts
@@ -3,4 +3,4 @@
 /(vendor|system/vendor)/bin/hw/android\.hardware\.light-service\.lineage u:object_r:hal_light_default_exec:s0
 
 # USB HAL
-/(vendor|system/vendor)/bin/hw/android\.hardware\.usb@1\.3-service\.basic u:object_r:hal_usb_default_exec:s0
+/(vendor|system/vendor)/bin/hw/android\.hardware\.usb-service\.basic u:object_r:hal_usb_default_exec:s0
