From 1a8b9470d68204810651c8417a7ed752e6f43d3f Mon Sep 17 00:00:00 2001
From: Egor <egor.su.8@gmail.com>
Date: Sun, 8 Nov 2026 13:20:07 +0300
Subject: [PATCH 03/15] mido: sepolicy: Only declare qti_debugfs on user builds

sepolicy-legacy-um already declares it via its debugfs policy on
userdebug/eng builds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 BoardConfig.mk               | 3 +++
 sepolicy/vendor-user/file.te | 2 ++
 sepolicy/vendor/file.te      | 3 ---
 3 files changed, 5 insertions(+), 3 deletions(-)
 create mode 100644 sepolicy/vendor-user/file.te

diff --git a/BoardConfig.mk b/BoardConfig.mk
index b348d5c..ca9572c 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -172,6 +172,9 @@ VENDOR_SECURITY_PATCH := 2026-04-05
 include device/miku/sepolicy/libion/sepolicy.mk
 include device/qcom/sepolicy-legacy-um/SEPolicy.mk
 BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
+ifeq ($(filter userdebug eng,$(TARGET_BUILD_VARIANT)),)
+BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor-user
+endif
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/private
 
 # SELinux - Lineage HALs not covered by Miku's common policy
diff --git a/sepolicy/vendor-user/file.te b/sepolicy/vendor-user/file.te
new file mode 100644
index 0000000..a727159
--- /dev/null
+++ b/sepolicy/vendor-user/file.te
@@ -0,0 +1,2 @@
+# Declared by sepolicy-legacy-um debugfs policy on userdebug/eng builds
+type qti_debugfs, fs_type, debugfs_type;
diff --git a/sepolicy/vendor/file.te b/sepolicy/vendor/file.te
index 20d0a0b..629da00 100644
--- a/sepolicy/vendor/file.te
+++ b/sepolicy/vendor/file.te
@@ -1,9 +1,6 @@
 # Camera
 type camera_socket, file_type, data_file_type;
 
-# DebugFS
-type qti_debugfs, fs_type, debugfs_type;
-
 # Fingerprint
 type fpc_data_file, file_type, data_file_type, core_data_file_type;
 type fpce_socket, file_type;
