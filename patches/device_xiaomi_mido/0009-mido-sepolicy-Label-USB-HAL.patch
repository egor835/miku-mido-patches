From e05613e11176383395d55077367940e4641a6433 Mon Sep 17 00:00:00 2001
From: Egor <egor.su.8@gmail.com>
Date: Mon, 9 Nov 2026 23:53:14 +0300
Subject: [PATCH 09/15] mido: sepolicy: Label USB HAL

Without a domain init refuses to start the usb@1.3 HAL and
UsbService blocks finishBooting forever waiting for IUsb, leaving
the device on "Phone is starting".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sepolicy/miku/vendor/file_contexts      | 3 +++
 sepolicy/miku/vendor/hal_usb_default.te | 5 +++++
 2 files changed, 8 insertions(+)
 create mode 100644 sepolicy/miku/vendor/hal_usb_default.te

diff --git a/sepolicy/miku/vendor/file_contexts b/sepolicy/miku/vendor/file_contexts
index b238051..53e7eeb 100644
--- a/sepolicy/miku/vendor/file_contexts
+++ b/sepolicy/miku/vendor/file_contexts
@@ -1,3 +1,6 @@
 /(vendor|system/vendor)/bin/hw/vendor\.lineage\.health-service\.default u:object_r:hal_lineage_health_default_exec:s0
 /(vendor|system/vendor)/bin/hw/android\.hardware\.ir-service\.lineage u:object_r:hal_ir_default_exec:s0
 /(vendor|system/vendor)/bin/hw/android\.hardware\.light-service\.lineage u:object_r:hal_light_default_exec:s0
+
+# USB HAL
+/(vendor|system/vendor)/bin/hw/android\.hardware\.usb@1\.3-service\.basic u:object_r:hal_usb_default_exec:s0
diff --git a/sepolicy/miku/vendor/hal_usb_default.te b/sepolicy/miku/vendor/hal_usb_default.te
new file mode 100644
index 0000000..fe276eb
--- /dev/null
+++ b/sepolicy/miku/vendor/hal_usb_default.te
@@ -0,0 +1,5 @@
+# From LineageOS device/lineage/sepolicy (common/vendor)
+allow hal_usb_default configfs:dir create_dir_perms;
+allow hal_usb_default configfs:file create_file_perms;
+allow hal_usb_default proc_deny_new_usb:file w_file_perms;
+allow hal_usb_default self:capability sys_admin;
