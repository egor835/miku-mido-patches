 create mode 100644 sepolicy/miku/vendor/hal_lineage_livedisplay_qti.te
 create mode 100644 sepolicy/miku/vendor/hal_lineage_touch_default.te

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 7c19825..b348d5c 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -169,11 +169,18 @@ TARGET_USES_OLD_MNC_FORMAT := true
 VENDOR_SECURITY_PATCH := 2026-04-05
 
 # SELinux
-include device/lineage/sepolicy/libion/sepolicy.mk
+include device/miku/sepolicy/libion/sepolicy.mk
 include device/qcom/sepolicy-legacy-um/SEPolicy.mk
 BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/private
 
+# SELinux - Lineage HALs not covered by Miku's common policy
+SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/miku/public
+SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/miku/private
+BOARD_VENDOR_SEPOLICY_DIRS += \
+    $(DEVICE_PATH)/sepolicy/miku/dynamic \
+    $(DEVICE_PATH)/sepolicy/miku/vendor
+
 # Treble
 PRODUCT_FULL_TREBLE_OVERRIDE := true
 
