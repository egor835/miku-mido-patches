From 1cd4230a24c139e5616c73fea0fd441df4b6963a Mon Sep 17 00:00:00 2001
From: Egor 835 <egor.su.8@gmail.com>
Date: Thu, 12 Nov 2026 12:53:45 +0300
Subject: [PATCH 17/19] mido: Allow soft AP in the Wi-Fi HAL

The interface combination only listed STA, so the framework never tried
to create an AP interface and the hotspot failed right away. Pronto
can't run STA and AP concurrently; expose them as alternatives.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 BoardConfig.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 46767e0..2ed7bad 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -196,7 +196,7 @@ BOARD_WLAN_DEVICE := qcwcn
 BOARD_WPA_SUPPLICANT_DRIVER := NL80211
 BOARD_WPA_SUPPLICANT_PRIVATE_LIB := //hardware/qcom-caf/wlan/qcwcn:lib_driver_cmd_qcwcn
 TARGET_HAS_BROKEN_WLAN_SET_INTERFACE := true
-WIFI_HAL_INTERFACE_COMBINATIONS := {{{STA}, 1}}
+WIFI_HAL_INTERFACE_COMBINATIONS := {{{STA}, 1}}, {{{AP}, 1}}
 WIFI_DRIVER_STATE_CTRL_PARAM := "/sys/module/wlan/parameters/fwpath"
 WIFI_DRIVER_STATE_ON := ""
 WIFI_DRIVER_STATE_OFF := ""
-- 
