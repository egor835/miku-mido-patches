From df37da3ca8caca273dd4d5ab49797b4f7db27287 Mon Sep 17 00:00:00 2001
From: Egor <egor.su.8@gmail.com>
Date: Mon, 9 Nov 2026 21:47:04 +0300
Subject: [PATCH 07/16] mido: releasetools: Ship flash_super_dummy.sh and run
 it via sh

Miku's AOSP updater has no set_metadata and the build doesn't pack
$(PRODUCT_OUT)/install into the OTA.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 AndroidBoard.mk | 3 +++
 releasetools.py | 7 ++++---
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/AndroidBoard.mk b/AndroidBoard.mk
index 7e32cc9..dc7044e 100644
--- a/AndroidBoard.mk
+++ b/AndroidBoard.mk
@@ -17,3 +17,6 @@ $(INSTALLED_SUPERIMAGE_DUMMY_TARGET): $(PRODUCT_OUT)/super_empty.img $(LPFLASH)
 super_dummyimage: $(INSTALLED_SUPERIMAGE_DUMMY_TARGET)
 
 INSTALLED_RADIOIMAGE_TARGET += $(INSTALLED_SUPERIMAGE_DUMMY_TARGET)
+
+# Shipped in the OTA by releasetools.py
+INSTALLED_RADIOIMAGE_TARGET += $(LOCAL_PATH)/configs/flash_super_dummy.sh
diff --git a/releasetools.py b/releasetools.py
index 4919a17..ca16198 100644
--- a/releasetools.py
+++ b/releasetools.py
@@ -25,7 +25,8 @@ def AddImage(info, dir, basename, dest):
 
 def FullOTA_InstallBegin(info):
   AddImage(info, "RADIO", "super_dummy.img", "/tmp/super_dummy.img");
-  info.script.AppendExtra('package_extract_file("install/bin/flash_super_dummy.sh", "/tmp/flash_super_dummy.sh");')
-  info.script.AppendExtra('set_metadata("/tmp/flash_super_dummy.sh", "uid", 0, "gid", 0, "mode", 0755);')
-  info.script.AppendExtra('run_program("/tmp/flash_super_dummy.sh");')
+  # AOSP doesn't pack $(PRODUCT_OUT)/install into the OTA nor provide
+  # set_metadata in its updater, so ship the script ourselves and run it via sh.
+  AddImage(info, "RADIO", "flash_super_dummy.sh", "/tmp/flash_super_dummy.sh");
+  info.script.AppendExtra('run_program("/system/bin/sh", "/tmp/flash_super_dummy.sh");')
   return
