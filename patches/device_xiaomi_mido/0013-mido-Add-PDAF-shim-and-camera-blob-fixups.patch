From b8eafd49054c8ee545646681b836899f61aa7195 Mon Sep 17 00:00:00 2001
From: Egor <egor.su.8@gmail.com>
Date: Tue, 10 Nov 2026 20:17:20 +0300
Subject: [PATCH 13/16] mido: Add PDAF shim and camera blob fixups

Skip PDAF instead of crashing when the rear module's EEPROM calibration
isn't available, and stop the sensor module from skipping modules with
unrecognized EEPROM IDs. Supersedes the camera_config.xml fallbacks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 extract-files.py    | 15 +++++++++++++--
 libshims/Android.bp | 12 ++++++++++++
 libshims/pdafshim.c | 37 +++++++++++++++++++++++++++++++++++++
 3 files changed, 62 insertions(+), 2 deletions(-)
 create mode 100644 libshims/pdafshim.c

diff --git a/extract-files.py b/extract-files.py
index 93530f7..bde8797 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -4,6 +4,8 @@
 # SPDX-License-Identifier: Apache-2.0
 #
 
+import re
+
 from extract_utils.fixups_blob import (
     blob_fixup,
     blob_fixups_user_type,
@@ -41,9 +43,18 @@ lib_fixups: lib_fixups_user_type = {
 blob_fixups: blob_fixups_user_type = {
     # Camera - Path fixups
     'vendor/bin/mm-qcamera-daemon': blob_fixup()
-        .binary_regex_replace(b'/data/misc/camera/cam_socket', b'/data/vendor/qcam/cam_socket'),
+        .binary_regex_replace(b'/data/misc/camera/cam_socket', b'/data/vendor/qcam/cam_socket')
+        .add_needed('libpdafshim.so'),
     'vendor/lib/libmmcamera2_sensor_modules.so': blob_fixup()
-        .binary_regex_replace(b'/system/etc/camera', b'/vendor/etc/camera'),
+        .binary_regex_replace(b'/system/etc/camera', b'/vendor/etc/camera')
+        # sensor_init_xml_probe: don't skip modules whose EEPROM module ID isn't
+        # recognized (bne -> nop); the kernel still matches sensor ID/address.
+        .binary_regex_replace(re.escape(b'\x00\x28\x76\xd1\xd9\xf8\x00\x00'),
+                              b'\x00\x28\x00\xbf\xd9\xf8\x00\x00')
+        # port_sensor_create: treat a PDAF init failure as "no PDAF" instead of
+        # failing the stream (bgt.w -> b.w).
+        .binary_regex_replace(re.escape(b'\xff\x3f\x00\xf3\xf8\x85\xdf\xf8\x7c\x04'),
+                              b'\xff\x3f\x00\xf0\xf8\xbd\xdf\xf8\x7c\x04'),
     ('vendor/lib/libmmcamera2_cpp_module.so', 'vendor/lib/libmmcamera2_dcrf.so', 'vendor/lib/libmmcamera2_iface_modules.so', 'vendor/lib/libmmcamera2_imglib_modules.so', 'vendor/lib/libmmcamera2_mct.so', 'vendor/lib/libmmcamera2_pproc_modules.so', 'vendor/lib/libmmcamera2_q3a_core.so', 'vendor/lib/libmmcamera2_sensor_modules.so', 'vendor/lib/libmmcamera2_stats_algorithm.so', 'vendor/lib/libmmcamera2_stats_modules.so', 'vendor/lib/libmmcamera_dbg.so', 'vendor/lib/libmmcamera_imglib.so', 'vendor/lib/libmmcamera_pdafcamif.so', 'vendor/lib/libmmcamera_pdaf.so', 'vendor/lib/libmmcamera_tintless_algo.so', 'vendor/lib/libmmcamera_tintless_bg_pca_algo.so', 'vendor/lib/libmmcamera_tuning.so'): blob_fixup()
         .binary_regex_replace(b'/data/misc/camera/', b'/data/vendor/qcam/'),
     # Camera - Property fixup
diff --git a/libshims/Android.bp b/libshims/Android.bp
index b0a9581..3afda3c 100644
--- a/libshims/Android.bp
+++ b/libshims/Android.bp
@@ -42,3 +42,15 @@ cc_library_shared {
