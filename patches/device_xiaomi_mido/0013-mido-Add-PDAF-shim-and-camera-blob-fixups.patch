diff --git a/libshims/pdafshim.c b/libshims/pdafshim.c
new file mode 100644
index 0000000..547b023
--- /dev/null
+++ b/libshims/pdafshim.c
@@ -0,0 +1,37 @@
+// Skip PDAF when the module has no usable EEPROM calibration.
+//
+// Xiaomi's mido camera stack passes NULL-based garbage (e.g. 0x11f84) as the
+// PDAF calibration pointer when the rear module's EEPROM data isn't loaded,
+// and libmmcamera_pdaf memcpy()s from it, killing mm-qcamera-daemon on
+// full-resolution streams. pdaf_init() already handles a NULL handle by
+// running without PDAF, so return NULL in that case.
+#include <android/log.h>
+#include <dlfcn.h>
+#include <stdint.h>
+
+#define TAG "pdafshim"
+#define PARAM_PD_TYPE   0x24a0  // 3 = dual PD, doesn't use this calibration
+#define PARAM_CAL_DATA  0xc70   // copied to ctx+0x4ed4 by set_pd_context_init_info
+
+typedef void *(*pdaf_init_t)(void *);
+
+void *PDAF_PhaseDetection_init(void *param) {
+    static pdaf_init_t real;
+    if (!real) {
+        void *h = dlopen("libmmcamera_pdaf.so", RTLD_NOW);
+        real = h ? (pdaf_init_t)dlsym(h, "PDAF_PhaseDetection_init") : NULL;
+        if (!real) {
+            __android_log_print(ANDROID_LOG_ERROR, TAG, "real PDAF_PhaseDetection_init not found");
+            return NULL;
+        }
+    }
+    if (param && *(uint32_t *)((char *)param + PARAM_PD_TYPE) != 3) {
+        uintptr_t cal = *(uintptr_t *)((char *)param + PARAM_CAL_DATA);
+        if (cal < 0x100000) {
+            __android_log_print(ANDROID_LOG_WARN, TAG,
+                                "no PDAF calibration (%p), running without PDAF", (void *)cal);
+            return NULL;
+        }
+    }
+    return real(param);
+}
